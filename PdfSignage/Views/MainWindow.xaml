<Window x:Class="PdfSignage.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PDFサイネージ"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Background="Black"
        Focusable="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Image Source="{Binding CurrentImage}"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Visibility="{Binding ShowImage, Converter={StaticResource BoolToVisibility}}" />

        <MediaElement x:Name="VideoPlayer"
                      Source="{Binding VideoSource}"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Stop"
                      Stretch="Uniform"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Volume="1.0"
                      ScrubbingEnabled="False"
                      MediaEnded="VideoPlayer_MediaEnded"
                      MediaFailed="VideoPlayer_MediaFailed"
                      Visibility="{Binding IsVideoVisible, Converter={StaticResource BoolToVisibility}}" />

        <!-- 空フォルダ時（小さめ・運用者向け） -->
        <TextBlock Foreground="Gray"
                   FontSize="16"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextAlignment="Center"
                   Text="{Binding EmptyMessage}"
                   Visibility="{Binding ShowEmptyFolderMessage, Converter={StaticResource BoolToVisibility}}" />

        <!-- 復帰不能時（大きく・来場者向け） -->
        <Border Padding="64"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{Binding ShowRecoveryMessage, Converter={StaticResource BoolToVisibility}}">
            <StackPanel MaxWidth="1400">
                <TextBlock Text="{Binding EmptyMessage}"
                           FontSize="56"
                           FontWeight="SemiBold"
                           Foreground="White"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           LineHeight="80" />
                <TextBlock Margin="0,32,0,0"
                           FontSize="36"
                           Foreground="#CCCCCC"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Text="お手数ですが、担当者までご連絡ください。" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
