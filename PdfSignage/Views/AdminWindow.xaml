<Window x:Class="PdfSignage.Views.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="640"
        Height="680"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="管理モード"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Margin="0,0,0,16" />

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="監視フォルダ"
                           FontWeight="SemiBold" />
                <Grid Margin="0,6,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding WatchFolderPath, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1"
                            Margin="8,0,0,0"
                            Padding="12,6"
                            Content="参照..."
                            Command="{Binding BrowseWatchFolderCommand}" />
                </Grid>

                <TextBlock Text="デフォルト表示秒数（5〜300）"
                           FontWeight="SemiBold" />
                <TextBox Margin="0,6,0,16"
                         Width="120"
                         HorizontalAlignment="Left"
                         Text="{Binding DefaultDisplaySecondsText, UpdateSourceTrigger=PropertyChanged}" />

                <CheckBox Content="Windows 起動時にアプリを自動起動する"
                          Margin="0,0,0,4"
                          IsChecked="{Binding WindowsAutoStart}" />
                <TextBlock Margin="0,0,0,16"
                           FontSize="11"
                           Foreground="Gray"
                           TextWrapping="Wrap"
                           Text="※ レジストリ（Run キー）に登録します。ログオン後に自動起動します。" />

                <TextBlock Text="アプリ終了時刻（日次）"
                           FontWeight="SemiBold" />
                <StackPanel Margin="0,6,0,16"
                            Orientation="Horizontal">
                    <CheckBox VerticalAlignment="Center"
                              Content="有効"
                              IsChecked="{Binding AppExitTimeEnabled}" />
                    <TextBox Margin="12,0,0,0"
                             Width="80"
                             VerticalAlignment="Center"
                             IsEnabled="{Binding AppExitTimeEnabled}"
                             Text="{Binding AppExitTime, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="Gray"
                               Text="HH:mm（例: 18:00）" />
                </StackPanel>

                <TextBlock Text="PC 電源オフ時刻（日次）"
                           FontWeight="SemiBold" />
                <StackPanel Margin="0,6,0,16"
                            Orientation="Horizontal">
                    <CheckBox VerticalAlignment="Center"
                              Content="有効"
                              IsChecked="{Binding PcShutdownTimeEnabled}" />
                    <TextBox Margin="12,0,0,0"
                             Width="80"
                             VerticalAlignment="Center"
                             IsEnabled="{Binding PcShutdownTimeEnabled}"
                             Text="{Binding PcShutdownTime, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="Gray"
                               Text="HH:mm（アプリ終了の3分後が初期値、例: 18:03）" />
                </StackPanel>
                <TextBlock Margin="0,0,0,4"
                           FontSize="11"
                           Foreground="Gray"
                           TextWrapping="Wrap"
                           Text="※ 指定時刻に shutdown /s /t 0 を実行します。グループポリシー等により失敗する場合はログを確認してください。" />
                <TextBlock Margin="0,0,0,16"
                           FontSize="11"
                           Foreground="Gray"
                           TextWrapping="Wrap"
                           Text="※ 管理者権限は通常不要ですが、環境によっては電源オフが拒否されることがあります。" />

                <TextBlock Text="復帰不能時メッセージ"
                           FontWeight="SemiBold" />
                <TextBox Margin="0,6,0,0"
                         Height="72"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         Text="{Binding RecoveryMessage, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2"
                Margin="0,16,0,0"
                Padding="16,10"
                HorizontalAlignment="Left"
                Content="保存して設定する"
                Command="{Binding SaveAndApplyCommand}" />

        <TextBlock Grid.Row="3"
                   Margin="0,12,0,0"
                   Foreground="Gray"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Text="× を閉じる → アプリを終了 / Ctrl+Shift+M → 通常モード（キオスク）に戻る" />

        <TextBlock Grid.Row="4"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Text="{Binding StatusMessage}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="DarkGreen" />
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasValidationError}" Value="True">
                            <Setter Property="Foreground" Value="DarkRed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding HasStatusMessage}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <StackPanel Grid.Row="5"
                    Margin="0,16,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left">
            <Button Padding="16,10"
                    Content="通常モード（キオスク）に戻る"
                    Command="{Binding ReturnToKioskCommand}" />
            <Button Margin="12,0,0,0"
                    Padding="16,10"
                    Content="アプリを終了"
                    Command="{Binding ExitApplicationCommand}" />
        </StackPanel>
    </Grid>
</Window>
