<Window x:Class="KS_Signage.Issuer.Views.IssuerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="アクセスキー発行"
        Width="920"
        Height="740"
        MinWidth="760"
        MinHeight="560"
        Language="ja-JP"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="アクセスキー発行"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Margin="0,0,0,4" />
        <TextBlock Grid.Row="0"
                   Margin="0,36,0,16"
                   FontSize="12"
                   Foreground="Gray"
                   TextWrapping="Wrap"
                   Text="販売側専用です。現場の配布フォルダには入れないでください。発行したキーは下の一覧と secrets/issued-access-keys.json に残ります。" />

        <Border Grid.Row="1"
                Padding="16"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                Background="#FAFAFA">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="契約の通し番号" />
                <StackPanel Grid.Row="0"
                            Grid.Column="1"
                            Margin="0,0,0,12">
                    <TextBox Width="200"
                             HorizontalAlignment="Left"
                             Text="{Binding SerialNumber, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="0,4,0,0"
                               FontSize="11"
                               Foreground="Gray"
                               Text="必須。台帳と揃える（例: C-0001）。問い合わせ照合用。" />
                </StackPanel>

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="組織名" />
                <StackPanel Grid.Row="1"
                            Grid.Column="1"
                            Margin="0,0,0,12">
                    <TextBox Text="{Binding Organization, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="0,4,0,0"
                               FontSize="11"
                               Foreground="Gray"
                               Text="任意。問い合わせ時に管理画面へ出ます。" />
                </StackPanel>

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="プラン" />
                <StackPanel Grid.Row="2"
                            Grid.Column="1"
                            Margin="0,0,0,12"
                            Orientation="Horizontal">
                    <RadioButton VerticalAlignment="Center"
                                 Content="標準（契約上 5 台）"
                                 GroupName="Plan"
                                 IsChecked="{Binding IsStandardPlan, Mode=TwoWay}" />
                    <RadioButton Margin="16,0,0,0"
                                 VerticalAlignment="Center"
                                 Content="サイト（台数無制限）"
                                 GroupName="Plan"
                                 IsChecked="{Binding IsSitePlan, Mode=TwoWay}" />
                </StackPanel>

                <TextBlock Grid.Row="3"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="契約期限" />
                <StackPanel Grid.Row="3"
                            Grid.Column="1"
                            Margin="0,0,0,12">
                    <DatePicker Width="180"
                                HorizontalAlignment="Left"
                                SelectedDate="{Binding ExpiresOnDate, Mode=TwoWay}" />
                    <TextBlock Margin="0,4,0,0"
                               FontSize="11"
                               Foreground="Gray"
                               TextWrapping="Wrap"
                               Text="必須。その日の終わりまで有効。新規は発行日＋1 年、期限内の更新はいまの期限の翌日から 1 年。" />
                </StackPanel>

                <Button Grid.Row="4"
                        Grid.Column="1"
                        Padding="16,10"
                        HorizontalAlignment="Left"
                        Content="アクセスキーを発行"
                        Command="{Binding IssueCommand}" />

                <TextBlock Grid.Row="5"
                           Grid.Column="0"
                           Grid.ColumnSpan="2"
                           Margin="0,12,0,0"
                           FontSize="11"
                           Foreground="Gray"
                           TextWrapping="Wrap"
                           Text="{Binding PrivateKeyStatus}" />

                <TextBlock Grid.Row="6"
                           Grid.Column="0"
                           Grid.ColumnSpan="2"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           Text="{Binding StatusMessage}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="DarkGreen" />
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasValidationError}" Value="True">
                                    <Setter Property="Foreground" Value="DarkRed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasStatusMessage}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2"
                   Margin="0,20,0,8"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Text="作成済みアクセスキー" />

        <Grid Grid.Row="3">
            <TextBlock VerticalAlignment="Top"
                       Foreground="Gray"
                       Text="まだ発行したアクセスキーはありません。">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasIssuedKeys}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasIssuedKeys}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <ItemsControl ItemsSource="{Binding IssuedKeys}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,10"
                                    Padding="12"
                                    BorderBrush="#DDDDDD"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Grid.Column="0"
                                               TextWrapping="Wrap">
                                        <Run FontWeight="SemiBold" Text="{Binding SerialNumber, Mode=OneWay}" />
                                        <Run Text="  " />
                                        <Run Text="{Binding OrganizationLabel, Mode=OneWay}" />
                                        <Run Text="  /  " />
                                        <Run Text="{Binding PlanLabel, Mode=OneWay}" />
                                        <Run Text="  /  期限 " />
                                        <Run Text="{Binding ExpiresOn, Mode=OneWay}" />
                                        <Run Text="  /  発行 " />
                                        <Run Text="{Binding IssuedAtLabel, Mode=OneWay}" />
                                    </TextBlock>

                                    <Button Grid.Row="0"
                                            Grid.Column="1"
                                            Margin="12,0,0,0"
                                            Padding="12,6"
                                            VerticalAlignment="Top"
                                            Content="コピー"
                                            Command="{Binding DataContext.CopyKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />

                                    <TextBox Grid.Row="1"
                                             Grid.Column="0"
                                             Grid.ColumnSpan="2"
                                             Margin="0,8,0,0"
                                             IsReadOnly="True"
                                             TextWrapping="Wrap"
                                             FontFamily="Consolas"
                                             FontSize="12"
                                             Text="{Binding AccessKey, Mode=OneWay}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
