<Window x:Class="KS_Signage.Views.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="640"
        Height="620"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="管理モード"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Margin="0,0,0,16" />

        <TabControl Grid.Row="1">
            <TabItem Header="再生設定">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Padding="12,16,12,8">
                    <StackPanel>
                        <TextBlock Text="監視フォルダ"
                                   FontWeight="SemiBold" />
                        <StackPanel Margin="0,6,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding WatchFolderPath, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Padding="12,6"
                                        Content="参照..."
                                        Command="{Binding BrowseWatchFolderCommand}" />
                            </Grid>
                            <TextBlock Margin="0,4,0,0"
                                       FontSize="11"
                                       Foreground="Gray"
                                       TextWrapping="Wrap"
                                       Text="この製品では、この PC 内のフォルダのみ指定できます。">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowLocalWatchFolderHint}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <TextBlock Text="デフォルト表示秒数（5〜300）"
                                   FontWeight="SemiBold" />
                        <TextBox Margin="0,6,0,16"
                                 Width="120"
                                 HorizontalAlignment="Left"
                                 Text="{Binding DefaultDisplaySecondsText, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="復帰不能時メッセージ"
                                   FontWeight="SemiBold" />
                        <TextBox Margin="0,6,0,16"
                                 Height="72"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="{Binding RecoveryMessage, UpdateSourceTrigger=PropertyChanged}" />

                        <CheckBox Content="Windows 起動時にアプリを自動起動する"
                                  Margin="0,0,0,4"
                                  IsChecked="{Binding WindowsAutoStart}" />
                        <TextBlock Margin="0,0,0,16"
                                   FontSize="11"
                                   Foreground="Gray"
                                   TextWrapping="Wrap"
                                   Text="※ レジストリ（Run キー）に登録します。ログオン後に自動起動します。" />

                        <TextBlock Text="終了時刻（日次）"
                                   FontWeight="SemiBold" />
                        <StackPanel Margin="0,6,0,8"
                                    Orientation="Horizontal">
                            <CheckBox VerticalAlignment="Center"
                                      Content="有効"
                                      IsChecked="{Binding AppExitTimeEnabled}" />
                            <TextBox Margin="12,0,0,0"
                                     Width="80"
                                     VerticalAlignment="Center"
                                     IsEnabled="{Binding AppExitTimeEnabled}"
                                     Text="{Binding AppExitTime, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="Gray"
                                       Text="HH:mm（例: 18:00）" />
                        </StackPanel>
                        <TextBlock Margin="0,0,0,4"
                                   FontSize="11"
                                   Foreground="Gray"
                                   TextWrapping="Wrap"
                                   Text="※ 指定時刻にアプリを終了し、直ちに PC の電源を切ります。グループポリシー等により電源オフが失敗する場合はログを確認してください。" />
                        <TextBlock Margin="0,0,0,0"
                                   FontSize="11"
                                   Foreground="Gray"
                                   TextWrapping="Wrap"
                                   Text="※ 管理者権限は通常不要ですが、環境によっては電源オフが拒否されることがあります。" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="ライセンス等">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Padding="12,16,12,8">
                    <StackPanel>
                        <TextBlock Text="ライセンス"
                                   FontWeight="SemiBold" />
                        <Grid Margin="0,6,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Margin="0,0,16,6"
                                       Foreground="Gray"
                                       Text="状態" />
                            <TextBlock Grid.Row="0"
                                       Grid.Column="1"
                                       Margin="0,0,0,6"
                                       Text="{Binding LicenseStatusText}" />
                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Margin="0,0,16,6"
                                       Foreground="Gray"
                                       Text="期限" />
                            <TextBlock Grid.Row="1"
                                       Grid.Column="1"
                                       Margin="0,0,0,6"
                                       Text="{Binding LicenseExpiresText}" />
                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Margin="0,0,16,6"
                                       Foreground="Gray"
                                       Text="契約番号" />
                            <TextBlock Grid.Row="2"
                                       Grid.Column="1"
                                       Margin="0,0,0,6"
                                       Text="{Binding LicenseSerialNumberText}" />
                            <TextBlock Grid.Row="3"
                                       Grid.Column="0"
                                       Margin="0,0,16,0"
                                       Foreground="Gray"
                                       Text="組織名" />
                            <TextBlock Grid.Row="3"
                                       Grid.Column="1"
                                       Text="{Binding LicenseOrganizationText}" />
                        </Grid>

                        <TextBlock Text="アクセスキー"
                                   FontWeight="SemiBold" />
                        <StackPanel Margin="0,6,0,16">
                            <TextBox MinHeight="48"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="False"
                                     VerticalScrollBarVisibility="Auto"
                                     Text="{Binding AccessKeyInput, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Margin="0,8,0,0"
                                    Padding="12,6"
                                    HorizontalAlignment="Left"
                                    Content="アクセスキーを適用"
                                    Command="{Binding ApplyAccessKeyCommand}" />
                            <TextBlock Margin="0,4,0,0"
                                       FontSize="11"
                                       Foreground="Gray"
                                       TextWrapping="Wrap"
                                       Text="メールで届いたアクセスキーを貼り付けて適用します。空のまま保存すると、いまのキーを維持します。" />
                        </StackPanel>

                        <TextBlock Text="ログフォルダ"
                                   FontWeight="SemiBold" />
                        <TextBox Margin="0,6,0,0"
                                 IsReadOnly="True"
                                 Text="{Binding LogDirectory, Mode=OneWay}" />
                        <TextBlock Margin="0,4,0,0"
                                   FontSize="11"
                                   Foreground="Gray"
                                   TextWrapping="Wrap"
                                   Text="障害時は、このフォルダのログをメールに添付してください。クラウドには送りません。" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Button Grid.Row="2"
                Margin="0,16,0,0"
                Padding="16,10"
                HorizontalAlignment="Left"
                Content="保存して設定する"
                Command="{Binding SaveAndApplyCommand}" />

        <TextBlock Grid.Row="3"
                   Margin="0,12,0,0"
                   Foreground="Gray"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Text="× を閉じる / Ctrl+Shift+M → 表示モードに戻る" />

        <TextBlock Grid.Row="4"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Text="{Binding StatusMessage}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="DarkGreen" />
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasValidationError}" Value="True">
                            <Setter Property="Foreground" Value="DarkRed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding HasStatusMessage}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <WrapPanel Grid.Row="5"
                   Margin="0,16,0,0">
            <Button Margin="0,0,12,8"
                    Padding="16,10"
                    Content="表示モードに戻る"
                    Command="{Binding ReturnToKioskCommand}" />
            <Button Margin="0,0,12,8"
                    Padding="16,10"
                    Content="アプリ終了"
                    Command="{Binding ExitApplicationCommand}" />
            <Button Margin="0,0,0,8"
                    Padding="16,10"
                    Content="アプリを終了して PC を電源オフ"
                    Command="{Binding ExitAndPowerOffCommand}" />
        </WrapPanel>
    </Grid>
</Window>
